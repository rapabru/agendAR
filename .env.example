# Supabase Configuration
# Obtén estas credenciales en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Calendar Integration (OAuth 2.0)
# Obtén estas credenciales en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_APP_URL=https://agendar-one.vercel.app

# Optional Default AI Provider (si se desea dar crédito por defecto en el backend)
GEMINI_API_KEY=
